CHIP RAM16K {
    IN in[16], load, address[14];
    OUT out[16];

    PARTS:
    DMux4Way(in= load, sel= address[0..1], a= a, b= b , c= c, d= d);
    RAM4K(in= in, load= a, address= address[2..13], out= ao);
    RAM4K(in= in, load= b, address= address[2..13], out= bo);
    RAM4K(in= in, load= c, address= address[2..13], out= co);
    RAM4K(in= in, load= d, address= address[2..13], out= do);
    Mux4Way16(a= ao, b= bo, c= co, d= do, sel= address[0..1], out= out);

}